{


  "name": "Allow Copy+ Origin",
  "description": "__MSG_ext_desc__",
  "version": "3.0.10",
  "manifest_version": 3,
  "default_locale": "en",
  "background": {
    "service_worker": "dist/background.js"
  },
  "options_page": "/options/index.html",
  "permissions": [
    "scripting",
    "storage",
    "contextMenus",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "action": {
    "default_icon": {
      "16": "/images/32.png",
      "32": "/images/32.png",
      "48": "/images/48.png",
      "128": "/images/128.png"
    }
  },
  "icons": {
    "16": "/images/32.png",
    "32": "/images/32.png",
    "48": "/images/48.png",
    "128": "/images/128.png"
  }
}
