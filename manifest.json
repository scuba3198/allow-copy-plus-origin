{


  "name": "Allow Copy+ Origin",
  "description": "__MSG_ext_desc__",
  "version": "3.0.9",
  "manifest_version": 3,
  "default_locale": "en",
  "background": {
    "service_worker": "dist/background.js"
  },
  "options_page": "/options/index.html",
  "permissions": [
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_icon": {
      "16": "/images/32.png",
      "32": "/images/32.png",
      "48": "/images/48.png",
      "128": "/images/128.png"
    }
  },
  "icons": {
    "16": "/images/32.png",
    "32": "/images/32.png",
    "48": "/images/48.png",
    "128": "/images/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "images/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}